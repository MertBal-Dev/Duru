# ============================================================
# DURU'NUN ATÖLYESİ — Ortam Değişkenleri
#
# Bu dosyayı ".env.local" adıyla kopyala ve değerleri doldur.
# .env.local git'e GİTMEZ (.gitignore'da) — anahtarlarını korur.
#
# Değerleri nereden alacaksın:
#   Supabase panel → Project Settings → API
# ============================================================

# Proje adresi (Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# Genel anahtar (anon / public key)
# Bu anahtar tarayıcıya gider ve gitmesi normaldir — tek başına
# hiçbir veriye erişemez, çünkü tüm tablolarda satır düzeyi
# güvenlik (RLS) açık. ASLA "service_role" anahtarını buraya yazma.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Sitenin canlı adresi (paylaşım görselinin doğru çalışması için)
# Yerelde çalışırken boş bırakabilirsin.
NEXT_PUBLIC_SITE_URL=https://durununatolyesi.vercel.app
